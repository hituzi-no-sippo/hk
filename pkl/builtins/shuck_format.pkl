import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

/// Formats sh, bash, mksh, bats and zsh scripts with shuck.
///
/// Formatting options and `format.exclude` come from `.shuck.toml` or `shuck.toml`. Embedded
/// GitHub Actions `run:` blocks are linted by the `shuck` builtin but are not formatted.
@Builtins.meta {
  category = "Shell"
  description = "Fast shell script formatter (part of shuck)"
  project_indicators {
    new { glob = "*.sh"; recursive = true }
    new { file = ".shuck.toml" }
    new { file = "shuck.toml" }
  }
  mise_tools = List("aqua:ewhauser/shuck")
}
shuck_format = new Config.Step {
  batch = true
  match_any =
    List(
      new Config.FileSelector {
        glob =
          List(
            "**/*.sh",
            "**/*.bash",
            "**/*.zsh",
            "**/*.ksh",
            "**/*.dash",
            "**/*.mksh",
            "**/*.bats",
          )
      },
      new Config.FileSelector { types = List("sh", "bash", "zsh") },
    )
  // `--diff` prints a unified diff with `a/` and `b/` headers and exits 1 when a file would change.
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("shuck", "format", "--force-exclude", "--diff", "{{files}}")
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("shuck", "format", "--force-exclude", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = "test.sh"
      extra_files = new Mapping<String, String> {
        [".shuck.toml"] = "[format]\nexclude = [\"excluded.sh\"]\n"
      }
    }
    local const before = "foo(){\necho hi\n}\n"
    local const after = "foo() {\n\techo hi\n}\n"
    ["check bad file"] = testMaker.checkFail(before, 1)
    ["check good file"] = testMaker.checkPass(after)
    ["diff bad file"] = testMaker.diffPass(before, after)
    ["fix bad file"] = testMaker.fixPass(before, after)
    ["fix good file"] = testMaker.fixPass(after, after)
    ["check respects config exclude"] = testMaker.withFilename("excluded.sh").checkPass(before)
    ["fix respects config exclude"] = testMaker.withFilename("excluded.sh").fixPass(before, before)
  }
}
