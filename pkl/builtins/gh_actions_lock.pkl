import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

local const lockfile = ".github/workflows/actions.lock"

// `--verify-local` makes no network calls and needs no authentication, but
// passes when the lockfile still records a deleted workflow, so this also
// looks for those.
local function verifyLocal(flags: String): String =
  """
  gh-actions-lock --verify-local\(flags) || exit
  test -f \(lockfile) || exit 0
  stale=$(sed -n "/^workflows:/,/^[^ ]/s/^    '\\(.*\\)':$/\\1/p" \(lockfile) |
    while IFS= read -r workflow; do test -e "$workflow" || echo "$workflow"; done)
  test -z "$stale" && exit 0
  echo "\(lockfile) records deleted workflows; run gh-actions-lock to prune them:" >&2
  echo "$stale" >&2
  exit 1
  """

@Builtins.meta {
  category = "Infrastructure"
  description =
    "Lock GitHub Actions dependencies, including transitive ones, in .github/workflows/actions.lock"
  project_indicators {
    new { file = ".github/workflows/actions.lock" }
  }
  mise_tools = List("aqua:github/gh-actions-lock")
}
const gh_actions_lock = new Config.Step {
  // No `glob`: gh-actions-lock always runs on the whole `.github/workflows`
  // directory, because it prunes the entries of deleted workflows only then,
  // and hk doesn't pass deleted files to steps. A step with a glob would not
  // run on a commit that only deletes a workflow.
  step_condition = "exec_ok('test -d .github/workflows')"
  stage = List(".github/workflows/*.yml", ".github/workflows/*.yaml", lockfile)
  // `--fail-on-warning` also fails on warnings the fixer can't clear, such as
  // a workspace-local `uses: ./…` action, so they are fixed by hand.
  check = new Config.CommandSpec {
    command = verifyLocal(" --fail-on-warning")
    effect = "read"
  }
  // The fixer calls the GitHub API, so it runs only when the offline check
  // fails. `check_first` doesn't do this: hk honors it only when another step
  // writes the same files. The check here ignores warnings, because the fixer
  // can't clear them and would call the API on every run.
  fix = new Config.CommandSpec {
    command =
      """
      if (
      \(verifyLocal(""))
      ) >/dev/null 2>&1; then exit 0; fi
      exec gh-actions-lock --no-interactive
      """
    effect = "write"
  }
  tests {
    local const init = "git init --quiet"
    local const workflow =
      """
      name: ci
      on: push
      jobs:
        test:
          runs-on: ubuntu-latest
          steps:
            - uses: actions/checkout@v4.2.2

      """
    local const lock =
      """
      # This file is machine-generated by `gh actions-lock`.
      # Do not edit by hand; run `gh actions-lock` to update.
      # Docs: https://gh.io/actions-lockfile
      version: 'v0.0.3'
      workflows:
          '.github/workflows/ci.yml':
              - 'actions/checkout@v4.2.2'
      dependencies:
          'actions/checkout@v4.2.2':
              ref: 'v4.2.2'
              commit: 'sha1-11bd71901bbe5b1630ceea73d27597364c9af683'
              owner_id: 44036562
              repo_id: 197814629

      """
    local const staleLock =
      """
      # This file is machine-generated by `gh actions-lock`.
      # Do not edit by hand; run `gh actions-lock` to update.
      # Docs: https://gh.io/actions-lockfile
      version: 'v0.0.3'
      workflows:
          '.github/workflows/ci.yml':
              - 'actions/checkout@v4.2.2'
          '.github/workflows/deleted.yml':
              - 'actions/checkout@v4.2.2'
      dependencies:
          'actions/checkout@v4.2.2':
              ref: 'v4.2.2'
              commit: 'sha1-11bd71901bbe5b1630ceea73d27597364c9af683'
              owner_id: 44036562
              repo_id: 197814629

      """
    local const testMaker = new helpers.TestMaker {
      filename = lockfile
      before = init
      extra_files = new Mapping<String, String> {
        [".github/workflows/ci.yml"] = workflow
      }
    }
    ["check good file"] = testMaker.checkPass(lock)
    ["check missing entry"] = testMaker.checkFail("version: 'v0.0.3'\n", 1)
    ["check deleted workflow"] = testMaker.checkFail(staleLock, 1)
    ["fix good file"] = testMaker.fixPass(lock, lock)
    // Pinning a full semver tag doesn't narrow it, so it resolves to the same
    // commit until the tag moves.
    ["fix missing lockfile"] = new Config.StepTest {
      run = "fix"
      tmpdir = true
      before = init
      write = new Mapping<String, String> {
        [".github/workflows/ci.yml"] = workflow
      }
      expect {
        files { [lockfile] = lock }
      }
    }
    ["fix deleted workflow"] = testMaker.fixPass(staleLock, lock)
    // gh-actions-lock warns about a workspace-local action, and its fixer
    // can't clear the warning, so the fix leaves the lockfile alone.
    local const localActionMaker = (testMaker) {
      extra_files {
        [".github/workflows/ci.yml"] = workflow + "      - uses: ./my-action\n"
      }
    }
    ["check warning"] = localActionMaker.checkFail(lock, 1)
    ["fix warning"] = localActionMaker.fixPass(lock, lock)
  }
}
